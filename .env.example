# Copy to .env.local for local development; set the same names in Vercel for production.

# 1 = first production deploy: marketing pages with a maintenance banner, app and API closed.
NEXT_PUBLIC_MAINTENANCE=

# Business message box: emailed through Resend (https://resend.com). Without these, messages are only kept locally.
RESEND_API_KEY=
CONTACT_TO=
# A sender on a domain verified in Resend, e.g. Mavya <hello@mavya.app>.
CONTACT_FROM=

# Library curation (founder only, local).
CURATOR=
NEXT_PUBLIC_CURATOR=
META_ACCESS_TOKEN=
IG_USER_ID=
GEMINI_API_KEY=
